# Copy to VPS:
#   cp deploy/env/backend.env.production /var/www/leadmanagement/backend/.env
# Then edit JWT_SECRET before going live.

PORT=5000
NODE_ENV=production

MONGO_URI=mongodb://127.0.0.1:27017/indiaholidaydestination_crm

JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING_MIN_32_CHARS
JWT_EXPIRES_IN=30d

CORS_ORIGINS=https://indiaholidaydestination.com,https://himachalcabservice.in,https://www.himachalcabservice.in
PLATFORM_DOMAIN=indiaholidaydestination.com
BRAND_WEBSITE=https://exploremybharat.com
BRAND_WEBSITE_HOST=exploremybharat.com
CRM_FRONTEND_URL=https://indiaholidaydestination.com/app

# Website quote forms → CRM leads (Himachal Cab / Explore My Bharat)
# Set WEBSITE_LEAD_COMPANY_SLUG to the company slug in Super Admin, then set a long random key.
# WEBSITE_LEAD_API_KEY=replace-with-long-random-secret
# WEBSITE_LEAD_COMPANY_SLUG=your-company-slug
# WEBSITE_LEAD_SOURCE_LABEL=Himachal Cab Website
# WEBSITE_LEAD_ALLOWED_ORIGINS=https://himachalcabservice.in,https://www.himachalcabservice.in

SEED_PASSWORD=123456

REDIS_URL=redis://127.0.0.1:6379

UNO_HOTELS_API_BASE_URL=https://unohotels-backend.onrender.com
